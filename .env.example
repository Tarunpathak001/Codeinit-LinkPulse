NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Supabase transaction pooler URL (port 6543); prepare:false is configured.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@YOUR_POOLER:6543/postgres
# Direct/session connection for migrations (port 5432).
MIGRATION_DATABASE_URL=
# Generate with: openssl rand -hex 32
AUTH_COOKIE_SECRET=
ADMIN_EMAILS=
BLOCKED_DOMAINS=
# Only enable behind Vercel; otherwise password attempts use a conservative shared bucket.
TRUST_VERCEL_PROXY=false
# Optional disposable PostgreSQL database for integration tests. Never production.
TEST_DATABASE_URL=
